# Escuta só no IP da LAN — evita conflito com systemd-resolved (127.0.0.53:53)
listen-address=10.1.1.10
bind-interfaces

no-hosts
addn-hosts=/etc/dnsmasq.hosts

domain=homelab.local
local=/homelab.local/
expand-hosts
domain-needed
bogus-priv

server=8.8.4.4
server=8.8.8.8

log-queries
log-facility=/var/log/dnsmasq.log
