DRONE_GITEA_SERVER=http://gitea:3000
DRONE_GITEA_CLIENT_ID=<change me>
DRONE_GITEA_CLIENT_SECRET=<change me>
DRONE_RPC_SECRET=<change me>
DRONE_SERVER_HOST=drone.homelab.local
DRONE_SERVER_PROTO=https
DRONE_USER_CREATE=<change me>
DRONE_RUNNER_VOLUMES=/path/in/container/cert/ca-bundle.crt:/etc/ssl/certs/ca-bundle.crt
DRONE_RUNNER_ENVIRON=SSL_CERT_FILE:/path/from/container/ca-bundle.crt,GIT_SSL_CAINFO:/path/in/container/ca-bundle.crt
SSL_CERT_FILE=/path/to/cert